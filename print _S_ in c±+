#include <iostream>
using namespace std;

int main(){

    for(int i=0;i<=4;i++){
        for(int j=1;j<=4;j++){
            if(i%2==0){
                if(j==1||j==4){
                    cout<<" ";
                }else{
                    cout<<"*";
                }
            }
            if (i<2){
                if(i%2!=0){
                    if(i==j){
                        cout<<"*";
                    }else{
                        cout<<" ";
                    }
                }
           }else{
              if (i%2 !=0){
                   if(j<=i){
                     cout<<" ";
                   }else{
                     cout<<"*";
                        }
              }
           }
        }
      
        cout<<endl;
      }
            

    return 0;
}
